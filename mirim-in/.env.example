# =========================================================
#  미림iN 환경변수 견본
#  이 파일을 복사해 같은 폴더에 .env 로 만들고 값을 채우세요.
#  .env 는 gitignore 되어 있으니 절대 커밋하지 마세요.
# =========================================================

# ===== DB (MySQL) - 필수 =====
# Railway 퍼블릭 URL: mysql://사용자:비밀번호@호스트:포트/DB이름
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mirim_in
DB_USERNAME=root
DB_PASSWORD=

# ===== Google OAuth - 필수 =====
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== 메일 (인증 코드 발송) - 필수 =====
# Gmail 주소 / Google 계정 2단계 인증 후 발급한 '앱 비밀번호'
MAIL_USERNAME=
MAIL_PASSWORD=

# ===== JWT - 로그인 기능부터 필요 =====
# 32바이트 이상 랜덤 문자열 (예: openssl rand -base64 32)
JWT_SECRET=

# ===== Cloudinary - 이미지 업로드부터 필요 =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== 프론트엔드 주소 - 선택 (기본값 http://localhost:3000) =====
FRONTEND_URL=http://localhost:3000
